package views

templ Home(reviews []Review) {
	@Layout("Home") {
		@Header("/gallery", "Gallery")
		@Services()
		<div class="flex flex-col gap-9 py-12 px-4">
			@Profile("/assets/marcus.webp", "Marcus Montgomery", "/assets/plates/book1-plate30.jpg", false) {
				Marcus has always had a passion to build and create, and an eye for detail. In 2021 he discovered his love for finish carpentry and fine woodworking through a restoration apprenticeship. He and his wife have one son and seek to do all to the glory of God.
			}
			<!--
			@Profile("/assets/gil.webp", "Gilead Rose", "/assets/plates/book4-plate68.jpg", true) {
				Gilead loves finish carpentry so much he sacrificed half a finger. What more do you need to know?
			}
			-->
		</div>
		@Reviews(reviews)
	}
}

templ Services() {
	<section class="relative isolate overflow-hidden px-6 py-16 sm:py-24 bg-zinc-900 text-vellum">
		<figure class="mx-auto max-w-4xl text-center">
			<div class="flex items-center gap-3 text-accent" aria-hidden="true">
				<span class="h-px flex-1 bg-current opacity-30"></span>
				<span class="text-xs">&#9670;</span>
				<span class="h-px flex-1 bg-current opacity-30"></span>
			</div>
			<div class="my-8 font-serif text-3xl italic leading-snug text-balance sm:my-10 sm:text-5xl">
				Services
			</div>
				<p class="mb-8 font-serif text-md sm:text-lg uppercase tracking-[0.3em] opacity-70 sm:mb-10">
					Cabinet Installation
				</p>
				<p class="mb-8 font-serif text-md sm:text-lg uppercase tracking-[0.3em] opacity-70 sm:mb-10">
					Custom Millwork
				</p>
				<p class="mb-8 font-serif text-md sm:text-lg uppercase tracking-[0.3em] opacity-70 sm:mb-10">
					Historic Restoration
				</p>
			<div class="flex items-center gap-3 text-accent" aria-hidden="true">
				<span class="h-px flex-1 bg-current opacity-30"></span>
				<span class="text-xs">&#9670;</span>
				<span class="h-px flex-1 bg-current opacity-30"></span>
			</div>
		</figure>
	</section>
}
